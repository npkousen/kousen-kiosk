#!/usr/bin/env python3
import json
import os
import queue
import re
import socket
import subprocess
import sys
import threading
import time

CONFIG_FILE = "/etc/kousen-kiosk/config.env"
NORMAL_EVENTS = {"volume", "mute", "play", "pause", "play_pause", "home"}


def usage():
    return "Usage: kousen-kiosk-osd <volume|mute|play|pause|play-pause|home|button|event> ..."


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        base = f"/tmp/kousen-kiosk-{os.getuid()}"
    path = os.path.join(base, "kousen-kiosk")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def socket_path():
    return os.path.join(runtime_dir(), "osd.sock")


def log_path():
    home = os.path.expanduser("~")
    path = os.path.join(home, ".local", "share", "kousen-kiosk")
    os.makedirs(path, exist_ok=True)
    return os.path.join(path, "osd.log")


def log(message):
    try:
        with open(log_path(), "a", encoding="utf-8") as handle:
            handle.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {message}\n")
    except Exception:
        pass


def read_config():
    config = {
        "KIOSK_OSD_LEVEL": "normal",
        "KIOSK_OSD_DURATION_MS": "1100",
        "KIOSK_OSD_FADE_MS": "350",
        "KIOSK_OSD_MARGIN": "32",
    }

    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip().strip('"').strip("'")
                if key.startswith("KIOSK_OSD_"):
                    config[key] = value
    except FileNotFoundError:
        pass
    except Exception as exc:
        log(f"Could not read config: {exc}")

    for key in config:
        if key in os.environ:
            config[key] = os.environ[key]

    return config


def int_config(config, key, fallback):
    try:
        return int(config.get(key, fallback))
    except ValueError:
        return fallback


def parse_event(argv):
    if argv and argv[0] in {"-h", "--help"}:
        print(usage())
        raise SystemExit(0)
    if not argv:
        print(usage(), file=sys.stderr)
        raise SystemExit(2)

    level_override = None
    args = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--level":
            if i + 1 >= len(argv):
                raise SystemExit("--level requires normal or detailed")
            level_override = argv[i + 1]
            i += 2
        elif arg.startswith("--level="):
            level_override = arg.split("=", 1)[1]
            i += 1
        else:
            args.append(arg)
            i += 1

    if not args:
        print(usage(), file=sys.stderr)
        raise SystemExit(2)

    kind = args[0].replace("-", "_")
    event = {
        "kind": kind,
        "title": kind.replace("_", " ").title(),
        "detail": "",
        "value": None,
        "muted": False,
        "level": level_override,
    }

    if kind == "volume":
        value = None
        muted = False
        for arg in args[1:]:
            if arg in {"--muted", "muted", "mute"}:
                muted = True
            elif re.match(r"^[0-9]+%?$", arg):
                value = max(0, min(100, int(arg.rstrip("%"))))
        event.update({
            "title": "Volume",
            "detail": "Muted" if muted else (f"{value}%" if value is not None else ""),
            "value": value,
            "muted": muted,
        })
    elif kind == "mute":
        state = args[1].lower() if len(args) > 1 else "toggle"
        muted = state in {"1", "on", "true", "yes", "muted"}
        event.update({
            "title": "Mute",
            "detail": "On" if muted else ("Off" if state not in {"toggle"} else "Toggled"),
            "muted": muted,
        })
    elif kind == "play_pause":
        event.update({"title": "Play/Pause", "detail": ""})
    elif kind in {"play", "pause", "home"}:
        event.update({"title": kind.replace("_", " ").title(), "detail": ""})
    elif kind == "button":
        name = args[1] if len(args) > 1 else "Unknown"
        detail = " ".join(args[2:]) if len(args) > 2 else ""
        event.update({"title": f"Button: {name}", "detail": detail})
    elif kind == "event":
        if len(args) > 1:
            event["kind"] = args[1].replace("-", "_")
        if len(args) > 2:
            event["title"] = args[2]
        if len(args) > 3:
            event["detail"] = " ".join(args[3:])
    else:
        detail = " ".join(args[1:])
        event.update({"title": f"Button: {args[0]}", "detail": detail})

    return event


def send_event(event):
    data = (json.dumps(event, separators=(",", ":")) + "\n").encode("utf-8")
    path = socket_path()
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(0.25)
            client.connect(path)
            client.sendall(data)
            return True
    except OSError:
        return False


def start_server():
    script = os.path.abspath(__file__)
    try:
        subprocess.Popen(
            [sys.executable, script, "--serve"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
        return True
    except Exception as exc:
        log(f"Could not start OSD server: {exc}")
        return False


def client_main(argv):
    event = parse_event(argv)
    if send_event(event):
        return 0
    if not start_server():
        return 0
    for _ in range(20):
        time.sleep(0.05)
        if send_event(event):
            return 0
    log("OSD server did not accept event")
    return 0


class OSDWindow:
    def __init__(self, root):
        self.root = root
        self.window = None
        self.title = None
        self.detail = None
        self.canvas = None
        self.fade_jobs = []

    def ensure_window(self):
        import tkinter as tk

        if self.window:
            return

        self.window = tk.Toplevel(self.root)
        self.window.withdraw()
        self.window.overrideredirect(True)
        self.window.attributes("-topmost", True)
        self.window.attributes("-alpha", 0.0)
        self.window.configure(bg="#101216")

        frame = tk.Frame(self.window, bg="#101216", padx=20, pady=16)
        frame.pack(fill="both", expand=True)

        self.title = tk.Label(
            frame,
            bg="#101216",
            fg="#f7f8fa",
            font=("Sans", 24, "bold"),
            anchor="w",
        )
        self.title.pack(fill="x")

        self.detail = tk.Label(
            frame,
            bg="#101216",
            fg="#b9c0cc",
            font=("Sans", 14),
            anchor="w",
        )
        self.detail.pack(fill="x", pady=(4, 0))

        self.canvas = tk.Canvas(
            frame,
            width=320,
            height=10,
            bg="#252a33",
            highlightthickness=0,
            bd=0,
        )
        self.canvas.pack(fill="x", pady=(14, 0))

    def should_show(self, event, config):
        level = (event.get("level") or config.get("KIOSK_OSD_LEVEL", "normal")).lower()
        if level == "detailed":
            return True
        return event.get("kind") in NORMAL_EVENTS

    def show(self, event):
        config = read_config()
        if not self.should_show(event, config):
            return

        self.ensure_window()
        for job in self.fade_jobs:
            try:
                self.root.after_cancel(job)
            except Exception:
                pass
        self.fade_jobs = []

        kind = event.get("kind", "")
        title = event.get("title") or kind.replace("_", " ").title()
        detail = event.get("detail") or ""
        value = event.get("value")
        muted = bool(event.get("muted"))

        if kind == "volume" and value is not None:
            detail = "Muted" if muted else f"{value}%"
        elif kind == "mute":
            detail = detail or ("On" if muted else "Off")

        self.title.configure(text=title)
        self.detail.configure(text=detail)
        self.draw_bar(value, muted)

        margin = int_config(config, "KIOSK_OSD_MARGIN", 32)
        width = 380
        height = 132 if value is not None else 104
        screen_width = self.window.winfo_screenwidth()
        x = max(margin, screen_width - width - margin)
        y = margin
        self.window.geometry(f"{width}x{height}+{x}+{y}")
        self.window.deiconify()
        self.window.lift()
        self.window.attributes("-alpha", 0.86)

        duration = int_config(config, "KIOSK_OSD_DURATION_MS", 1100)
        fade = int_config(config, "KIOSK_OSD_FADE_MS", 350)
        self.fade_jobs.append(self.root.after(duration, lambda: self.fade_out(fade)))

    def draw_bar(self, value, muted):
        self.canvas.delete("all")
        if value is None:
            self.canvas.pack_forget()
            return

        if not self.canvas.winfo_ismapped():
            self.canvas.pack(fill="x", pady=(14, 0))

        width = int(self.canvas.cget("width"))
        height = int(self.canvas.cget("height"))
        fill_width = int(width * max(0, min(100, value)) / 100)
        fill = "#7f8794" if muted else "#e7eefb"
        self.canvas.create_rectangle(0, 0, width, height, fill="#252a33", outline="")
        self.canvas.create_rectangle(0, 0, fill_width, height, fill=fill, outline="")

    def fade_out(self, fade_ms):
        steps = 10
        delay = max(10, int(fade_ms / steps))
        for step in range(steps):
            alpha = 0.86 * (1 - ((step + 1) / steps))
            self.fade_jobs.append(self.root.after(delay * (step + 1), lambda a=alpha: self.window.attributes("-alpha", a)))
        self.fade_jobs.append(self.root.after(delay * (steps + 1), self.window.withdraw))


def socket_server(events):
    path = socket_path()
    try:
        if os.path.exists(path):
            os.unlink(path)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(path)
        os.chmod(path, 0o600)
        server.listen(10)
    except Exception as exc:
        log(f"Could not open OSD socket: {exc}")
        return

    while True:
        try:
            conn, _ = server.accept()
            with conn:
                payload = b""
                while True:
                    chunk = conn.recv(4096)
                    if not chunk:
                        break
                    payload += chunk
                for line in payload.splitlines():
                    try:
                        events.put(json.loads(line.decode("utf-8")))
                    except Exception as exc:
                        log(f"Could not parse OSD event: {exc}")
        except Exception as exc:
            log(f"OSD socket error: {exc}")


def server_main():
    if not os.environ.get("DISPLAY"):
        log("DISPLAY is not set; OSD disabled")
        return 0

    try:
        import tkinter as tk
    except Exception as exc:
        log(f"tkinter is not available: {exc}")
        return 0

    events = queue.Queue()
    thread = threading.Thread(target=socket_server, args=(events,), daemon=True)
    thread.start()

    root = tk.Tk()
    root.withdraw()
    osd = OSDWindow(root)

    def pump():
        while True:
            try:
                event = events.get_nowait()
            except queue.Empty:
                break
            osd.show(event)
        root.after(40, pump)

    pump()
    log("OSD server started")
    root.mainloop()
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--serve":
        return server_main()
    return client_main(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
